{
  "chunk_bytes": 65536,
  "rule_set_id": "w1b5-assessment-v1",
  "rules": [
    {
      "category": "credential",
      "matcher": "assignment-value-ascii-ci",
      "max_value_bytes": 4096,
      "rule_id": "SEC-ASSIGNMENT",
      "terms": [
        "access_key",
        "access_token",
        "api_key",
        "apikey",
        "client_secret",
        "credential",
        "password",
        "private_key",
        "secret",
        "token"
      ]
    },
    {
      "category": "credential",
      "matcher": "scheme-value-ascii-ci",
      "max_value_bytes": 4096,
      "rule_id": "SEC-AUTH-SCHEME",
      "terms": [
        "Basic",
        "Bearer"
      ]
    },
    {
      "category": "credential",
      "matcher": "literal-ascii",
      "max_value_bytes": 0,
      "rule_id": "SEC-AWS-ACCESS-KEY",
      "terms": [
        "AKIA",
        "ASIA"
      ]
    },
    {
      "category": "privacy",
      "matcher": "literal-ascii",
      "max_value_bytes": 0,
      "rule_id": "SEC-HOME",
      "terms": [
        "/Users/",
        "/home/"
      ]
    },
    {
      "category": "credential",
      "matcher": "literal-ascii",
      "max_value_bytes": 0,
      "rule_id": "SEC-PRIVATE-KEY",
      "terms": [
        "-----BEGIN EC PRIVATE KEY-----",
        "-----BEGIN OPENSSH PRIVATE KEY-----",
        "-----BEGIN PRIVATE KEY-----",
        "-----BEGIN RSA PRIVATE KEY-----"
      ]
    },
    {
      "category": "credential",
      "matcher": "literal-ascii-ci",
      "max_value_bytes": 0,
      "rule_id": "SEC-SENTINEL",
      "terms": [
        "sentinel-secret"
      ]
    }
  ],
  "scanner_id": "ai-auto-lrc-byte-scanner-v1",
  "schema": "ai-auto-lrc/evidence-secret-rules",
  "schema_version": 1
}
